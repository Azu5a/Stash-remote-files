name: E-Hentai proxy group
desc: 添加E-Hentai策略组
proxy-groups:
  - name: 'E-Hentai'
    type: 'select'
    icon: 'https://e-hentai.org/favicon.ico'
    include-all: true
    proxies:
      - DIRECT
rules:
    - 'DOMAIN-SUFFIX,ehgt.org,E-Hentai'
    - 'DOMAIN-SUFFIX,e-hentai.org,E-Hentai'
    - 'DOMAIN-SUFFIX,exhentai.org,E-Hentai'
    - 'DOMAIN-SUFFIX,hath.network,E-Hentai'

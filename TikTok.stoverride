name: TikTok proxy group
desc: 添加TikTok策略组
proxy-groups:
  - name: 'TikTok'
    type: 'select'
    icon: 'https://raw.githubusercontent.com/Azu5a/Stash-remote-files/main/icon/TikTok.png'
    include-all: true
rules:
    - 'DOMAIN-SUFFIX,chatgpt.com,TikTok'
    - 'DOMAIN-SUFFIX,ttwstatic.com,TikTok'
    - 'DOMAIN-KEYWORD,tiktok,TikTok'

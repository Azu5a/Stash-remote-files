name: Emby proxy group
desc: 添加YKKCLOUD-Emby媒体服务策略组
proxy-groups:
  - name: 'Emby'
    type: 'select'
    icon: 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/emby.png'
    proxies:
      - DIRECT
      - Telegram
rules:
    - 'DOMAIN-SUFFIX,emby.moe,Emby'
    - 'DOMAIN-SUFFIX,xxlb.net,Emby'

name: Japan proxy group
desc: 添加日本网站策略组
proxy-groups:
  - name: 'Japan'
    type: 'select'
    icon: 'https://raw.githubusercontent.com/HotKids/Rules/master/Quantumult/X/Images/Flags/JP.png'
    include-all: true
    filter: '(?i)(日本|JP|Japan)'
rules:
    - 'DOMAIN-SUFFIX,jp,Japan'
    - 'GEOSITE,dlsite,Japan'
